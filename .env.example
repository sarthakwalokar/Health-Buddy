# Environment Configuration Example for Health Buddy

# Application Environment
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/healthbuddy_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_secure_password_123
POSTGRES_DB=healthbuddy_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123

# JWT Configuration (Min 256-bit secure secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=900000        # 15 minutes in milliseconds
JWT_REFRESH_EXPIRATION=604800000    # 7 days in milliseconds

# CORS & URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api/v1

# Admin Bootstrap Seed (Created automatically on initial run)
ADMIN_BOOTSTRAP_EMAIL=admin@healthbuddy.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@HealthBuddy2026!
ADMIN_BOOTSTRAP_NAME=System Administrator
